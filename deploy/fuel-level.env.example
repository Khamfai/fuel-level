# Copy to /etc/default/fuel-level and edit. Every line is optional.
# tls = Veeder-Root TLS-350 console over RS-232 (default); modbus = PWL-M200 probes on a USB-RS485 converter.
#TLS_SOURCE=tls
#TLS_PORT=/dev/ttyUSB0
#TLS_BAUD=9600
# modbus only: probe addresses in tank order (first = tank 1). Find them with: python3 probe_scan.py --find
#TLS_PROBE_ADDRS=1,2,3
# fuel-api base URL (no path). The poller calls /api/v1/logs and /api/v1/devices/<site>/heartbeat under it.
#TLS_API_URL=https://atg.moomou.com
#TLS_API_KEY=
#TLS_SITE_ID=station-1
# Set all three to register this site's device on startup (safe to leave set; "already exists" is fine).
#TLS_DEVICE_NAME=Station 1
#TLS_LAT=13.7563
#TLS_LNG=100.5018
#POLL_INTERVAL=60
