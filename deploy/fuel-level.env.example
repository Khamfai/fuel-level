# Copy to /etc/default/fuel-level and edit. Every line is optional.
# tls = Veeder-Root TLS-350 console over RS-232 (default)
# pokcenser = PWL-M200 probes on a USB-RS485 converter (4800 baud)
#TLS_SOURCE=pokcenser
#TLS_PORT=/dev/ttyUSB0
# Leave unset to use the source's default (9600; 4800 for pokcenser).
#TLS_BAUD=
# pokcenser only: console tank numbers to poll.
# Find them with: python3 probe_scan.py --find
#TLS_PROBE_ADDRS=3
# fuel-api base URL (no path). The poller calls /api/v1/logs and /api/v1/devices/<site>/heartbeat under it.
#TLS_API_URL=https://atg.moomou.com
#TLS_API_KEY=
#TLS_SITE_ID=station-1
# Set all three to register this site's device on startup (safe to leave set; "already exists" is fine).
#TLS_DEVICE_NAME=Station 1
#TLS_LAT=13.7563
#TLS_LNG=100.5018
#POLL_INTERVAL=60
